backtester/WhartonDataSource.parquet
backtester/WhartonDataSource2.parquet
backtester/WhartonDataSource3.parquet

# Sample / development caches not needed in production
backtester/cache/

# Docs and ad-hoc reports the backend never reads
backtester/*.md
backtester/*.txt
backtester/*.csv
backtester/wharton_alias_report_summary.txt
backtester/spy_wharton4_verification_report.txt

# …except the SUE event panel — PEADStrategy reads this at runtime.
!backtester/surprise earning.csv
